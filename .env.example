# ==============================================================================
# AutoClip Backend Environment Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# Active Spring Profile (set to 'prod' for production deployment)
SPRING_PROFILES_ACTIVE=prod

# Server Port (injected automatically by cloud platforms e.g. Render, Railway, AWS)
PORT=8090

# Database Configuration (PostgreSQL)
# Supports JDBC URL: jdbc:postgresql://<host>:<port>/<dbname>
DB_URL=jdbc:postgresql://localhost:5432/auto_clip
DB_USERNAME=postgres
DB_PASSWORD=
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=5

# Security / JWT (Base64-encoded secret key, min 32 bytes)
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# Initial Admin Credentials (will seed on startup if database is empty)
ADMIN_EMAIL=admin@autoclip.app
ADMIN_PASSWORD=

# Frontend Web Application URL
FRONTEND_REDIRECT=https://autoflow-app-phi.vercel.app/settings/accounts

# CORS Allowed Origins (comma-separated list for production, or * for open access)
CORS_ALLOWED_ORIGINS=https://autoflow-app-phi.vercel.app,http://localhost:3000

# Public Storage / CDN Base URL (e.g. https://api.yourdomain.com)
STORAGE_BASE_URL=

# TikTok OAuth Credentials & Callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.yourdomain.com/api/accounts/oauth2/callback/tiktok

# Facebook OAuth Credentials & Callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://api.yourdomain.com/api/accounts/oauth2/callback/facebook
FACEBOOK_SCOPE=public_profile

# Google / YouTube OAuth Credentials & Callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/accounts/oauth2/callback/youtube

# S3 / Cloud Asset Storage (optional)
S3_BUCKET=autoclip-assets
S3_REGION=us-east-1

# Swagger / OpenAPI Documentation (false recommended in production)
SWAGGER_ENABLED=false
